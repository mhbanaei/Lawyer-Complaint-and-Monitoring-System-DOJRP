# ----- توکن ربات (از Discord Developer Portal) -----
BOT_TOKEN=your_discord_bot_token_here

# ----- شناسهٔ اپلیکیشن (برای ثبت کامندها: npm run deploy) -----
CLIENT_ID=000000000000000000

# ----- نقش‌ها (Role ID) -----
# نقش شهروند: تنها کسانی که این نقش را دارند می‌توانند /shekayat بزنند
ROLE_CITIZEN=000000000000000000
# نقش قاضی: دسترسی به پنل تعیین وقت دادگاه و رأی نهایی
ROLE_JUDGE=000000000000000000
# نقش معاونت قضایی: مدیریت وکلا (add/remove/list) و مشاهدهٔ کامل پرونده‌ها
ROLE_DEPUTY=000000000000000000

# ----- کانال‌ها (Channel ID) -----
# کانال خروجی پرونده‌های شکایت
CHANNEL_COMPLAINTS=000000000000000000
# کانال اطلاعیهٔ تنظیم قرار دادگاه / وقت جلسه
CHANNEL_SESSIONS=000000000000000000

# ----- آدرس سرور بازیکنان (برای /addvakil و پایش آنلاین) -----
PLAYERS_URL=https://x.paradiserp.ir:30120/players.json
# فاصلهٔ پایش آنلاین‌بودن وکلا به ثانیه (پیش‌فرض ۳۰۰)
ONLINE_POLL_SECONDS=300

# ----- تنظیمات اختیاری -----
# ساعات قابل انتخاب برای جلسهٔ دادگاه (مثلاً 9-21)
SESSION_HOUR_START=9
SESSION_HOUR_END=21

# ----- Web complaint form -----
WEB_PORT=80
# Public URL used in the /shekayat button (set your VPS IP/domain if hosted remotely)
WEB_PUBLIC_URL=http://localhost

# ----- SSL (optional, for VPS HTTPS) -----
# SSL_CERT_PATH=C:\certs\cert.pem
# SSL_KEY_PATH=C:\certs\key.pem
# WEB_SSL_PORT=4289

# --- SSL خودکار (Let's Encrypt) ---
# دامنه با رکورد A به IP سرور؛ خالی = فقط HTTP. مثال: SSL_DOMAIN=lspd.ir
SSL_DOMAIN=
SSL_EMAIL=
WEB_SSL_PORT=443
